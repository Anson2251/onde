+/* onde patch: the creation site of an async resource.
+ *
+ * Returns "name (file:line:col)" for the stack frame `level` levels above the running code, or
+ * NULL when there is no JavaScript frame there. The host calls this from the promise hook to
+ * remember where an `await`/`then` chain was suspended, which is all `--async-stack-traces`
+ * needs to stitch the chain back together. The buffer is owned by the caller and released with
+ * JS_FreeStackFrameDesc. */
+char *JS_DescribeStackFrame(JSContext *ctx, int level)
+{
+    JSRuntime *rt = ctx->rt;
+    JSStackFrame *sf = rt->current_stack_frame;
+    JSObject *p;
+    JSFunctionBytecode *b = NULL;
+    DynBuf dbuf;
+    const char *func_name_str;
+    int line_num1, col_num1;
+    uint32_t pc;
+
+    while (level-- > 0 && sf != NULL)
+        sf = sf->prev_frame;
+    if (sf == NULL || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return NULL;
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (js_class_has_bytecode(p->class_id))
+        b = p->u.func.function_bytecode;
+
+    js_dbuf_init(ctx, &dbuf);
+    func_name_str = get_func_name(ctx, sf->cur_func);
+    if (!func_name_str || func_name_str[0] == '\0')
+        dbuf_printf(&dbuf, "<anonymous>");
+    else
+        dbuf_printf(&dbuf, "%s", func_name_str);
+    JS_FreeCString(ctx, func_name_str);
+
+    if (b && sf->cur_pc) {
+        const char *atom_str;
+        pc = sf->cur_pc - b->byte_code_buf - 1;
+        line_num1 = find_line_num(ctx, b, pc, &col_num1);
+        atom_str = b->filename ? JS_AtomToCString(ctx, b->filename) : NULL;
+        if (atom_str && line_num1 != -1)
+            dbuf_printf(&dbuf, " (%s:%d:%d)", atom_str, line_num1, col_num1);
+        JS_FreeCString(ctx, atom_str);
+    }
+    if (dbuf_error(&dbuf)) {
+        dbuf_free(&dbuf);
+        return NULL;
+    }
+    dbuf_putc(&dbuf, '\0');
+    if (dbuf_error(&dbuf)) {
+        dbuf_free(&dbuf);
+        return NULL;
+    }
+    return (char *)dbuf.buf;
+}
